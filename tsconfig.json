{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": false,
    "skipLibCheck": true,
    "types": [
      "chrome"
    ],
    "esModuleInterop": true
  },
  "include": [
    "src/**/*.ts"
  ]
}
